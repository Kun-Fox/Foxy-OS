+    SetPage(kPageHome);
+#if FOXY_UI_SELFTEST
+    xTaskCreate(SelfTestTask, "ui_selftest", 4096, nullptr, 2, nullptr);
+#endif
+    ESP_LOGI(TAG, "ui ready (pages=%d vol=%d)", kPageCount, volume_);
+    lv_obj_update_layout(home_);
