+void FoxyUI::BuildPageDots() {
+    for (int i = 0; i < kPageCount; i++) {
+        lv_obj_t* dot = lv_obj_create(lv_obj_get_parent(home_));
+        lv_obj_set_size(dot, 6, 6);
+        lv_obj_set_pos(dot, 160 - (kPageCount * 14) / 2 + i * 14, kStatusH + kPageH - 10);
