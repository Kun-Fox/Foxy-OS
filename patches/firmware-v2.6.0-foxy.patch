+lv_obj_t* MakeCard(lv_obj_t* parent, int x, int y, int w, int h) {
+    lv_obj_t* card = lv_obj_create(parent);
+    lv_obj_set_size(card, w, h);
+    lv_obj_set_pos(card, x, y);
