+class CoreS3LcdDisplay;
+
+// 页面语义：0=首页 1=应用页 2=设置页 3=原生对话界面（不画我们自己的层）
+// 触摸：按下记坐标；按住拖动用于设置页的音量/亮度滑条；抬起按位移判定滑动或点击。
+class FoxyUI {
+public:
