+void FoxyUI::UpdateCalcDisplay() {
+    if (calc_label_ == nullptr) {
+        return;
+    }
+    char buffer[32];
+    if (!calc_input_.empty()) {
+        snprintf(buffer, sizeof(buffer), "%s", calc_input_.c_str());
+    } else {
+        snprintf(buffer, sizeof(buffer), "%.10g", calc_acc_);
+    }
+    DisplayLockGuard lock(display_);
+    lv_label_set_text(calc_label_, buffer);
+}
+
+void FoxyUI::HandleCalcKey(int index) {
+    static const char* keys[16] = {"7", "8", "9", "÷", "4", "5", "6", "×",
+                                   "1", "2", "3", "−", "C", "0", "=", "+"};
+    const char* key = keys[index];
+    if (key[0] >= '0' && key[0] <= '9') {
+        if (calc_fresh_) {
+            calc_input_.clear();
+            calc_fresh_ = false;
+        }
+        if (calc_input_.size() < 12) {
+            calc_input_ += key[0];
+        }
+    } else if (key[0] == 'C') {
+        calc_input_.clear();
+        calc_acc_ = 0;
+        calc_op_ = 0;
+        calc_fresh_ = true;
+    } else if (key[0] == '=') {
+        double value = calc_input_.empty() ? calc_acc_ : strtod(calc_input_.c_str(), nullptr);
+        if (calc_op_ == '+') {
+            calc_acc_ += value;
+        } else if (calc_op_ == '-') {
+            calc_acc_ -= value;
+        } else if (calc_op_ == '*') {
+            calc_acc_ *= value;
+        } else if (calc_op_ == '/') {
+            calc_acc_ = (value == 0) ? 0 : calc_acc_ / value;
+        } else {
+            calc_acc_ = value;
+        }
+        calc_input_.clear();
+        calc_op_ = 0;
+        calc_fresh_ = true;
+    } else {
+        // 运算符：先把当前输入结算进累计值
+        double value = calc_input_.empty() ? calc_acc_ : strtod(calc_input_.c_str(), nullptr);
+        if (calc_op_ == '+') {
+            calc_acc_ += value;
+        } else if (calc_op_ == '-') {
+            calc_acc_ -= value;
+        } else if (calc_op_ == '*') {
+            calc_acc_ *= value;
+        } else if (calc_op_ == '/') {
+            calc_acc_ = (value == 0) ? 0 : calc_acc_ / value;
+        } else {
+            calc_acc_ = value;
+        }
+        calc_op_ = strcmp(key, "÷") == 0 ? '/' : (strcmp(key, "×") == 0 ? '*' :
+                                                  (strcmp(key, "−") == 0 ? '-' : '+'));
+        calc_input_.clear();
+        calc_fresh_ = true;
+    }
+    UpdateCalcDisplay();
+    ESP_LOGI(TAG, "calc key=%s acc=%.6g op=%c", key, calc_acc_, calc_op_ ? calc_op_ : '-');
+}
