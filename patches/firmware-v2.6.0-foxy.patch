+        case 0:
+            Application::GetInstance().ToggleChatState();
+            break;
+        case 1:
+            ToggleSpeakerMute();
+            break;
+        case 2:
+            ChangeVolume(-10);
+            break;
+        case 3:
+            ChangeVolume(10);
+            break;
+        case 4:
+            ToggleInfoPanel();
+            break;
+        default:
+            break;
+    }
+}
+
+bool CoreS3LcdDisplay::HandleTouch(int x, int y, bool short_tap) {
+    DisplayLockGuard lock(this);
+    ESP_LOGI(TAG, "touch x=%d y=%d", x, y);
+
+    // 信息页开着时，点任意位置关闭
+    if (info_panel_ != nullptr && !lv_obj_has_flag(info_panel_, LV_OBJ_FLAG_HIDDEN)) {
+        ToggleInfoPanel();
+        return true;
+    }
+
+    // 直接拿控件真实坐标做命中判断，避免自己算区域
+    for (int i = 0; i < kButtonCount; i++) {
+        if (buttons_[i] == nullptr) {
+            continue;
+        }
+        lv_area_t area;
+        lv_obj_get_coords(buttons_[i], &area);
+        if (x >= area.x1 && x <= area.x2 && y >= area.y1 && y <= area.y2) {
+            HandleButton(i);
+            return true;
+        }
+    }
+
+    // 控制条没命中，交给分页层（滑动切页 / 应用格点击）
+    if (FoxyUI::Get().OnRelease(x, y, short_tap)) {
+        return true;
+    }
+    return false;
+}
