+void FoxyUI::BuildCalculator() {
+    back_calc_ = MakeButton(calc_, 250, 6, 62, 26, "‹ 返回");
+    lv_obj_t* title = MakeLabel(calc_, "计算器", 0xF2F2F5);
+    lv_obj_set_pos(title, 14, 12);
