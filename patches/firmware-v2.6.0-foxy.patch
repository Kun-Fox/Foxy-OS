+// 设置页里的小圆角按钮，文字由外部填
+lv_obj_t* MakeButton(lv_obj_t* parent, int x, int y, int w, int h, const char* text) {
+    lv_obj_t* btn = MakeCard(parent, x, y, w, h);
+    lv_obj_clear_flag(btn, LV_OBJ_FLAG_CLICKABLE);
