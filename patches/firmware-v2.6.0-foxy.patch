+void Application::OpenStandbyChannel() {
+    if (GetDeviceState() != kDeviceStateIdle || protocol_ == nullptr) {
+        return;
+    }
+    if (protocol_->IsAudioChannelOpened()) {
+        return;
+    }
+    ESP_LOGI(TAG, "Opening standby channel");
+    if (!protocol_->OpenAudioChannel()) {
+        ESP_LOGW(TAG, "Standby channel open failed");
+    }
+}
+
+void Application::ArmStandbyTimer(int seconds) {
+    if (standby_timer_handle_ == nullptr) {
+        return;
+    }
+    esp_timer_stop(standby_timer_handle_);
+    esp_timer_start_once(standby_timer_handle_, (uint64_t)seconds * 1000000ULL);
+}
+
+void Application::CancelStandbyTimer() {
+    if (standby_timer_handle_ != nullptr) {
+        esp_timer_stop(standby_timer_handle_);
+    }
+}
+
+bool Application::SendTypedText(const std::string& text) {
+    if (text.empty() || protocol_ == nullptr) {
+        return false;
+    }
+    if (!protocol_->IsAudioChannelOpened()) {
+        if (!protocol_->OpenAudioChannel()) {
+            ESP_LOGW(TAG, "typed text: channel not open");
+            return false;
+        }
+    }
+    protocol_->SendTypedText(text);
+    ESP_LOGI(TAG, "typed text sent: %s", text.c_str());
+    return true;
+}
